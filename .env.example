# Phase 7 hosted media (backend only). Never send private artifact URLs to providers.
# Default runtime is local.v1. Hosted image editing is optional and demo-only.
# Public FLUX.1 Kontext Dev Space is non-commercial, quota-limited, and not production.
# Uncomment only for a local demo (shared ZeroGPU; expect timeouts):
# CATALOGFORGE_MEDIA_IMAGE_URL=https://black-forest-labs-flux-1-kontext-dev.hf.space
CATALOGFORGE_MEDIA_IMAGE_URL=
# Leave unset: GIF Creation uses local animation, not AI video.
CATALOGFORGE_MEDIA_VIDEO_URL=
CATALOGFORGE_MEDIA_API_TOKEN=
CATALOGFORGE_MEDIA_TIMEOUT_SECONDS=90
# Gradio Space API name only if IMAGE_URL is a *.hf.space demo endpoint.
CATALOGFORGE_MEDIA_IMAGE_API=infer
CATALOGFORGE_MEDIA_VIDEO_API=video

